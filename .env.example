# Copy to .env.local for your computer, and add the same values in Vercel → Settings → Environment Variables.
# Leave everything empty and the site uses content/site.ts and public/photos instead.

# Google service account (the "robot" that reads the Sheet and Drive folder)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# From the Sheet's URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=
# From the "Website Photos" folder URL: drive.google.com/drive/folders/<THIS PART> (can be changed later in /admin → Photos)
GOOGLE_DRIVE_FOLDER_ID=

# Cloudflare R2 photo storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public URL of the bucket, e.g. https://photos.bawngkawncorps.org or https://pub-xxxx.r2.dev
R2_PUBLIC_URL=

# Any long random text. Protects /api/sync.
CRON_SECRET=

# Admin logins for /admin, two or three people: name:password pairs separated by commas. Keep it private.
# (Passwords can't contain a comma.) Leave empty to switch the admin area off.
ADMIN_USERS=
# Optional: any long random text, used to sign the login cookie. If empty, one is derived from ADMIN_USERS.
AUTH_SECRET=

# Counselling requests are added to this PRIVATE Google Sheet (share it with the robot as Editor, and with the counsellors only).
# Its first tab must be called Requests. Leave empty and the form tells people to call instead.
GOOGLE_COUNSELLING_SHEET_ID=

# Optional: email the responsible person when a counselling request arrives (free at resend.com).
# The email only says "a new request came in" with a link to the Sheet. It never contains the message.
RESEND_API_KEY=
COUNSELLING_NOTIFY_EMAIL=
# Leave empty to send from Resend's test address (which can only email the Resend account owner).
NOTIFY_FROM_EMAIL=
